diff --git a/control-plane/tests/recipient-verification.test.ts b/control-plane/tests/recipient-verification.test.ts
index de209e8c..8248cb9d 100644
--- a/control-plane/tests/recipient-verification.test.ts
+++ b/control-plane/tests/recipient-verification.test.ts
@@ -331,3 +331,53 @@ it("adds Shared pool transports from a third map that never overrides another ma
   expect(verificationTransport("dedicated").provider_line_id).toBe("dedicated-line");
   expect(() => verificationTransport("shared")).toThrow(/not configured/);
 });
+
+it("resolves new isolated transports without changing any existing map", () => {
+  environment();
+  const primary = verificationTransport("pilot");
+  const additional = { ...primary, provider_line_id: "dedicated-line" };
+  const pool = { ...primary, provider_line_id: "pool-line" };
+  const isolated = { ...primary, provider_line_id: "isolated-line" };
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ADDITIONAL", JSON.stringify({ additional }));
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_POOL", JSON.stringify({ pool }));
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ISOLATED", JSON.stringify({ isolated }));
+  expect(verificationTransport("isolated")).toEqual(isolated);
+  for (const duplicate of [isolated, null, { token: "invalid" }]) {
+    vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ISOLATED", JSON.stringify({ pilot: duplicate, additional: duplicate, pool: duplicate }));
+    expect(verificationTransport("pilot")).toEqual(primary);
+    expect(verificationTransport("additional")).toEqual(additional);
+    expect(verificationTransport("pool")).toEqual(pool);
+  }
+});
+
+it.each(["not-json", "[]", "null", "42", '"text"'])("contains malformed isolated map %s", raw => {
+  environment();
+  const primary = verificationTransport("pilot");
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ISOLATED", raw);
+  expect(verificationTransport("pilot")).toEqual(primary);
+  expect(() => verificationTransport("isolated")).toThrow(/not configured/);
+});
+
+it("does not rescue invalid or ambiguous established entries with isolated credentials", () => {
+  environment();
+  const primary = verificationTransport("pilot");
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ISOLATED", JSON.stringify({ pilot: primary }));
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ADDITIONAL", JSON.stringify({ pilot: primary }));
+  expect(() => verificationTransport("pilot")).toThrow(/not configured/);
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ADDITIONAL", "{}");
+  vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS", JSON.stringify({ pilot: null }));
+  expect(() => verificationTransport("pilot")).toThrow(/not configured/);
+});
+
+it("validates isolated credentials and origins and rejects inherited keys", () => {
+  environment();
+  const primary = verificationTransport("pilot");
+  for (const bad of [{ ...primary, token: "short" }, { ...primary, origin: "http://example.test" }, { ...primary, origin: "https://example.test/path" }]) {
+    vi.stubEnv("CHERT_VERIFICATION_TRANSPORTS_ISOLATED", JSON.stringify({ isolated: bad }));
+    expect(() => verificationTransport("isolated")).toThrow(/not configured/);
+    expect(verificationTransport("pilot")).toEqual(primary);
+  }
+  expect(() => verificationTransport("missing")).toThrow(/not configured/);
+  expect(() => verificationTransport("toString")).toThrow(/not configured/);
+  expect(() => verificationTransport("__proto__")).toThrow(/not configured/);
+});
