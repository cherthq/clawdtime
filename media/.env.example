HOST=127.0.0.1
PORT=4212
MEDIA_DATABASE_PATH=.data/clawdtime-media.sqlite
MEDIA_MAX_SESSIONS=2
MEDIA_API_KEY=
BACKEND_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Enable only for a qualified caption-video pilot. Audio-only remains the default.
MEDIA_CAPTIONS_ENABLED=false

# Private gateway deployment and helper enrollment are separate prerequisites.
MEDIA_DEVICES_ENABLED=false
DEVICE_GATEWAY_URL=
DEVICE_GATEWAY_KEY=
# Preferred: gateway on the enrolled Mac opens outbound WSS; no public helper.
DEVICE_GATEWAY_RELAY=false

# Optional encrypted-ledger export; 32 random bytes encoded as 64 hex characters.
# GET /internal/ledger-backup also requires MEDIA_API_KEY; absent key disables it.
BACKUP_ENCRYPTION_KEY=
