# Independent pilot; never load Apple Teams environment into this process.
CLAWDTIME_MODE=simulation
CLAWDTIME_PORT=3310
CLAWDTIME_HOST=127.0.0.1
CLAWDTIME_ORIGIN=http://127.0.0.1:3310
CLAWDTIME_DATABASE=.data/clawdtime.sqlite
# Generate unique 32-byte secrets. Required for operator and media API access.
CLAWDTIME_OPERATOR_TOKEN=
CLAWDTIME_MEDIA_TOKEN=
# Live requires a reviewed handoff and verified exact provider/line binding.
CLAWDTIME_LIVE_TRAFFIC=false
# Publish the verified service line's Messages link on the live website only.
CLAWDTIME_PUBLIC_TEXTING=false
# Enable the conversational voice/text tool agent for live use.
# The historical AI_ACTIONS flag now gates this one agent; no parser fallback.
# Choose an explicit provider/model and independent key; no implicit fallback.
CLAWDTIME_AI_ACTIONS=false
CLAWDTIME_AI_PROVIDER=
CLAWDTIME_AI_MODEL=
# Optional generation controls; omit to keep unset reasoning and 800 output tokens.
# Reasoning models need room for both hidden reasoning and the visible/tool output.
# CLAWDTIME_AI_REASONING=low
# CLAWDTIME_AI_MAX_OUTPUT_TOKENS=4096
CLAWDTIME_OPENAI_API_KEY=
CLAWDTIME_AI_GATEWAY_KEY=
