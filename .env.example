# Independent pilot; never load Apple Teams environment into this process.
CLAWDTIME_MODE=simulation
CLAWDTIME_PORT=3310
CLAWDTIME_HOST=127.0.0.1
CLAWDTIME_ORIGIN=http://127.0.0.1:3310
CLAWDTIME_DATABASE=.data/clawdtime.sqlite
# Generate unique 32-byte secrets. Required for operator and media API access.
CLAWDTIME_OPERATOR_TOKEN=
CLAWDTIME_MEDIA_TOKEN=
# Live requires a reviewed handoff and verified exact provider/line binding.
CLAWDTIME_LIVE_TRAFFIC=false
# Publish the verified service line's Messages link on the live website only.
CLAWDTIME_PUBLIC_TEXTING=false
# Experimental two-way voice requires negotiated v2 support, the media-side
# MEDIA_TWO_WAY_VOICE_ENABLED flag, and physically qualified remote audio isolation.
# Keep both false until the intended handset/audio route has been qualified.
CLAWDTIME_TWO_WAY_VOICE_ENABLED=false
CLAWDTIME_REMOTE_AUDIO_ISOLATED=false
# Enable the conversational voice/text tool agent for live use.
# The historical AI_ACTIONS flag now gates this one agent; no parser fallback.
# Choose an explicit provider/model and independent key; no implicit fallback.
CLAWDTIME_AI_ACTIONS=false
CLAWDTIME_AI_PROVIDER=
CLAWDTIME_AI_MODEL=
# Optional generation controls; omit to keep unset reasoning and 800 output tokens.
# Reasoning models need room for both hidden reasoning and the visible/tool output.
# CLAWDTIME_AI_REASONING=low
# CLAWDTIME_AI_MAX_OUTPUT_TOKENS=4096
CLAWDTIME_OPENAI_API_KEY=
CLAWDTIME_AI_GATEWAY_KEY=

# Operator-only, execution-disabled audio qualification; never starts a call by itself.
CLAWDTIME_AUDIO_QUALIFICATION_ENABLED=false

# Shared asynchronous conversation; explicit provider/model, no implicit executor.
CLAWDTIME_CONVERSATION_ENABLED=false
CLAWDTIME_TEXT_PROVIDER=gateway
CLAWDTIME_TEXT_MODEL=openai/gpt-6-luna
# Read-only local document host; requires a fresh bounded local root grant.
CLAWDTIME_DOCUMENTS_ENABLED=false
# Separate exact-selection, paired-iMessage attachment effect.
CLAWDTIME_DOCUMENT_SEND_ENABLED=false
# General coding and desktop adapters remain independently gated.
CLAWDTIME_CODEX_RUNNER_ENABLED=false
CLAWDTIME_TEXT_CONTROL_ENABLED=false

# Default-off general screen camera; new v2 sessions and capable media/helper required.
CLAWDTIME_SCREEN_CAMERA_ENABLED=false
# Independently negotiated camera-only live target presentation; staged off by default.
CLAWDTIME_LIVE_PRESENTATION_ENABLED=false
