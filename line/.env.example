# Copy this file to .env.local and fill it in. Keep .env.local private: never commit it.

# The LiveKit project that your Chert line uses.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# The key for the realtime voice model. The clawdtime command gets the same key for its answers.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# The name that this agent registers with. Give the same name to: chert dev --agent
AGENT_NAME=clawdtime

# Optional. Each line shows the default.
# The project to use when you belong to several. ./host.sh passes it to chert dev.
# CLAWDTIME_LINE_CHERT_PROJECT=00000000-0000-0000-0000-000000000000
# The clawdtime command: a name on the PATH, or a full path.
# CLAWDTIME_LINE_CLAWDTIME=clawdtime
# The folder that the clawdtime command runs in. The default is the folder that the agent starts in.
# CLAWDTIME_LINE_PROJECT=/path/to/your/project
# The voice of the agent.
# CLAWDTIME_LINE_VOICE=marin
# The stone on the video: jet, jade, lapis, amber, garnet or amethyst.
# CLAWDTIME_LINE_MASCOT=jet
# The ffmpeg avfoundation device of the main screen. List the devices with:
#   ffmpeg -f avfoundation -list_devices true -i ""
# CLAWDTIME_LINE_SCREEN_DEVICE=1
# The health port of the worker. Change it when another agent on this Mac uses 8081.
# CLAWDTIME_LINE_PORT=8081
