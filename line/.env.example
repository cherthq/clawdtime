# Copy this file to .env.local and fill it in. Keep .env.local private: never commit it.

# The LiveKit project that your Chert line uses.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# The key for the realtime voice model. The clawdtime command gets the same key for its answers.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# The name that this agent registers with. Give the same name to: chert dev --agent
AGENT_NAME=clawdtime

# Optional. Each line shows the default.
# The project to use when you belong to several. ./host.sh passes it to chert dev.
# CLAWDTIME_LINE_CHERT_PROJECT=00000000-0000-0000-0000-000000000000
# The clawdtime command: a name on the PATH, or a full path.
# CLAWDTIME_LINE_CLAWDTIME=clawdtime
# The folder that the clawdtime command runs in. The default is the folder that the agent starts in.
# CLAWDTIME_LINE_PROJECT=/path/to/your/project
# The agent does not listen while it speaks: on a phone line its own voice comes back, and it would stop itself
# or answer itself. Set this to on only for a line that brings no voice back, to let the caller cut in.
# CLAWDTIME_LINE_BARGE_IN=off
# The Video framing of your line in Chert (the line's page in the dashboard): "fit" is Chert's default and sends
# the whole picture. "fill" sends only the middle of the picture, upright: set it here too, and the stone and a
# shared screen are drawn in that middle, so nothing is cut.
# CLAWDTIME_LINE_FRAMING=fit
# When the agent greets: "track" (the default) greets when the line's own audio track is in the room, which is
# when FaceTime is ready. "mark" waits for the ready mark of chert dev, about two seconds later.
# CLAWDTIME_LINE_GREET_ON=track
# The voice of the agent.
# CLAWDTIME_LINE_VOICE=marin
# The stone on the video: jet, jade, lapis, amber, garnet or amethyst.
# CLAWDTIME_LINE_MASCOT=jet
# The default uses the main screen by name, independent of attached cameras. List devices with:
#   ffmpeg -f avfoundation -list_devices true -i ""
# Custom numeric/non-main devices can be viewed, but automatic targeting is disabled to prevent mismatch.
# CLAWDTIME_LINE_SCREEN_DEVICE=Capture screen 0
# Automatic zoom is independent of computer use. Saved preferences override this initial default.
# CLAWDTIME_LINE_AUTO_ZOOM=on
# 10, 20 or 30. Default 20: eight samples per 400ms transition. See docs/AUTOMATIC_CALL_ZOOM.md.
# CLAWDTIME_LINE_VIDEO_FPS=20
# Native macOS Reduce Motion also disables camera animation when its events arrive.
# CLAWDTIME_LINE_REDUCED_MOTION=off
# Same private desktop state directory used by clawdtime chat; no extra credentials.
# CLAWDTIME_DESKTOP_STATE=/absolute/private/desktop
# The health port of the worker. Change it when another agent on this Mac uses 8081.
# CLAWDTIME_LINE_PORT=8081
